{
  "name": "forgeops-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.1.2"
  },
  "scripts": {
    "build": "pnpm --filter @forgeops/web build",
    "format:check": "pnpm --filter @forgeops/web format:check",
