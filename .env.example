FORGEOPS_ENVIRONMENT=DEV
FORGEOPS_ACTION_ADAPTER=MOCK
FORGEOPS_DATABASE_URL=sqlite+pysqlite:///./.local/forgeops.db
FORGEOPS_OBJECT_STORE_PATH=./.local/objects
FORGEOPS_EXTERNAL_MODEL_ENABLED=false
FORGEOPS_REAL_DATA_ENABLED=false
FORGEOPS_RUNTIME_PLUGINS_ENABLED=false
FORGEOPS_LOCAL_SYNTHETIC_ONLY=true
FORGEOPS_TEMPORAL_ADDRESS=127.0.0.1:7233
FORGEOPS_TEMPORAL_NAMESPACE=default
